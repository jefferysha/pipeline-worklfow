{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" session-start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" confirm-clear-prompt", "timeout": 5 },
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" breadcrumb", "timeout": 5 },
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" router", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" gate", "timeout": 5 },
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" codex-skill-receipt", "timeout": 5 },
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" terminal-activity", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|request_user_input",
        "hooks": [
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" confirm-clear", "timeout": 5 },
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" decision-recorder", "timeout": 5 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" skill-tracker", "timeout": 5 },
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" interactive-skill-gate", "timeout": 5 },
          { "type": "command", "command": "bash \"${HOME}/.local/bin/pipeline-hook\" terminal-activity", "timeout": 5 }
        ]
      }
    ]
  }
}
